{
  "expo": {
    "name": "SyncClipboard",
    "slug": "syncclipboard-mobile",
    "scheme": "syncclipboard",
    "version": "1.1.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "locales": {
      "en": "./src/i18n/native/en.json",
      "zh-Hans": "./src/i18n/native/zh-Hans.json"
    },
    "ios": {
      "bundleIdentifier": "com.jericx.syncclipboardmobile",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "SyncClipboard needs network access to connect to the sync server."
      }
    },
    "android": {
      "versionCode": 162,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jericx.syncclipboardmobile",
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/build/withNativeLogger.js",
      "./plugins/build/withNetworkSecurityConfig.js",
      "./plugins/build/withQuickSettingsTileManifest.js",
      "./plugins/build/withProcessTextManifest.js",
      "./plugins/build/withQuickActionActivity.js",
      "./plugins/build/withShareActivity.js",
      "./plugins/build/withServiceRestartActivity.js",
      "./plugins/build/withAndroidNativeCode.js",
      "./plugins/build/withClipboardOverlayPermission.js",
      "./plugins/build/withNativeUtilPermission.js",
      "./plugins/build/withSmsPermission.js",
      "./plugins/build/withStaticSmsReceiver.js",
      "./plugins/build/withForegroundService.js",
      "./plugins/build/withShizukuProvider.js",
      "./plugins/build/withDarkSplashScreen.js",
      "./plugins/build/withAbiSplits.js",
      [
        "expo-sharing",
        {
          "android": {
            "enabled": false,
            "singleShareMimeTypes": ["*/*"]
          }
        }
      ],
      ["expo-build-properties", { "ios": { "deploymentTarget": "15.1" } }],
      "expo-localization",
      "expo-sqlite"
    ]
  }
}
